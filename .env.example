# Copy to .env, then append a secret — the README has the one-liner:
#
#   printf 'SECRET_KEY_BASE=%s\n' "$(openssl rand -hex 64)" >> .env
#
# Deliberately not defined here: compose refuses to start while it is empty, so
# an empty definition would only be a trap. This application stores no
# credentials, so it is the only secret it needs — there is no
# config/master.key to hand around.

PORT=3000

# true boots a populated board to look at. Leave false for a real club.
SEED_ON_FIRST_BOOT=false

# Both true behind a TLS-terminating proxy. Plain HTTP needs them off, or every
# write redirects to an https:// port that is not listening.
RAILS_ASSUME_SSL=false
RAILS_FORCE_SSL=false
