<%= form_with url: url, method: :get, class: "search" do %>
  <%= label_tag :search, label, class: "visually-hidden" %>
  <%= search_field_tag :search, listing.query, placeholder: label %>
  <%= hidden_field_tag :sort, listing.sort %>
  <%= hidden_field_tag :dir, listing.direction %>
  <%= submit_tag "Search" %>
  <% if listing.searching? %>
    <%= link_to "Clear", url, class: "clear" %>
  <% end %>
<% end %>
